# ==============================================================================
# DMRC INTERNSHIP PORTAL - ENVIRONMENT VARIABLES
#
# Copy this file to `.env` in the same folder as manage.py, then fill in the
# values below.
#
# Every variable the application reads is listed here. Anything absent falls
# back to a development default, which is safe on a laptop and refused on a
# server -- see the two checks at the end of settings.py.
#
# `.env` holds live credentials. Keep it out of version control, and set the
# file so that only the account running the application can read it.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE  (required)
#
# DB_NAME must match the database the master schema created. Intern_Portal.sql
# creates `dmrc_internship_portal`; if DMRC's naming convention requires
# something else, change it in both places.
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=dmrc_internship_portal
DB_USER=production_admin
DB_PASSWORD=secure_intranet_password_here
DB_HOST=mysql_host_or_ip_here
DB_PORT=3306

# ------------------------------------------------------------------------------
# DATABASE TRANSPORT SECURITY
#
# Does the MySQL server require an encrypted connection?
#
#   DB_SSL=False   plain connection. Typical for a MySQL server on an internal
#                  network. If unsure, start here -- a server that requires TLS
#                  will refuse the connection and say so.
#   DB_SSL=True    encrypted. DB_SSL_CA must then point at the CA bundle used to
#                  verify the server's certificate.
#
# DB_SSL_CA paths:
#   Linux   /etc/ssl/certs/ca-certificates.crt   (Debian, Ubuntu)
#           /etc/pki/tls/certs/ca-bundle.crt     (RHEL, CentOS, Rocky)
#   macOS   /etc/ssl/cert.pem
#
# Leave DB_SSL_CA empty to encrypt WITHOUT verifying the server certificate.
# Acceptable on a closed internal network; not otherwise.
#
# If these two lines are omitted entirely, the connection is encrypted for any
# host that is not local -- which is what TiDB Cloud required during
# development, and is unlikely to be what an internal MySQL server wants.
# ------------------------------------------------------------------------------
DB_SSL=False
DB_SSL_CA=

# ------------------------------------------------------------------------------
# SECRET KEY  (required in production)
#
# Signs session cookies and the short-lived document viewer links. A key that
# has ever been published means both can be forged, so generate a fresh one:
#
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# The server REFUSES TO START if this is left as the development key.
# ------------------------------------------------------------------------------
SECRET_KEY=generate_a_new_highly_secure_random_key_here

# ------------------------------------------------------------------------------
# IDENTITY  (required in production)
#
# The portal authenticates nobody. Identity comes from DMRC's employee login;
# the portal only decides what an identified employee may do here.
#
# Integration is ONE method: implement get_employee_code() in
# portal/identity/intranet.py, then set the line below. See
# portal/identity/base.py for the contract.
#
# The default is a DEVELOPMENT provider that trusts an X-DMRC-Employee request
# header -- anyone who can reach the server could impersonate any employee,
# including a SYS-ADMIN. The server REFUSES TO START on it in production.
# ------------------------------------------------------------------------------
IDENTITY_PROVIDER=portal.identity.intranet.IntranetIdentityProvider

# ------------------------------------------------------------------------------
# HOSTS  (required in production)
#
# Comma-separated. Django rejects requests for any host not listed here once
# DEBUG is off. Include every name and address the portal is reached by.
# ------------------------------------------------------------------------------
ALLOWED_HOSTS=portal.dmrc.org,10.20.30.40

# ------------------------------------------------------------------------------
# DEBUG  (required in production -- do not leave this out)
#
# DEBUG defaults to ON when started with `python manage.py runserver`, and OFF
# when served through wsgi.py by Gunicorn or uWSGI, which is how a deployed
# instance runs.
#
# SET IT EXPLICITLY TO False ON ANY SERVER. Without this line, anyone who starts
# the application with `manage.py runserver` -- to check the install works, say
# -- turns DEBUG back on. That disables both production safety checks, re-enables
# the development identity provider that trusts a request header, and opens
# browser access to every origin.
#
# With this line present, that command fails instead, and prints why.
#
# NEVER set DEBUG=True on a server: an unhandled error then returns a full stack
# trace AND the settings, including these database credentials, to whoever
# triggered it.
# ------------------------------------------------------------------------------
DEBUG=False

# ------------------------------------------------------------------------------
# BROWSER ACCESS
#
# The two portals are served as static pages, so their requests to this API are
# cross-origin. Allowing every origin is fine on a laptop and wrong on a
# network: it lets any site an employee visits call this API as them.
#
# Set CORS_ALLOW_ALL_ORIGINS=False and list the address the portals are served
# from, scheme included.
#
# If the web server serves the portal pages AND forwards /api/ to this
# application from the same address, requests are not cross-origin and neither
# setting has any effect. That is the simpler arrangement.
# ------------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://portal.dmrc.org

# ------------------------------------------------------------------------------
# EMAIL  (required in production)
#
# Development leaves every line below commented out: messages print to the
# terminal and no mail server is needed.
#
# On a deployed server the first three are MANDATORY. settings.py refuses to
# start without them, because the alternative is a portal that records
# notifications as Sent while printing them to a console nobody is reading.
# ------------------------------------------------------------------------------
# EMAIL_MODE=smtp
# EMAIL_HOST=
# DEFAULT_FROM_EMAIL=

# The rest are optional. These defaults suit an unauthenticated internal relay
# on port 25, which is the common arrangement inside an organisation.
#
# EMAIL_USE_TLS and EMAIL_USE_SSL are mutually exclusive: TLS is STARTTLS on
# port 587, SSL is implicit TLS on port 465. Turning both on refuses to start.
# EMAIL_PORT=25
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=20
# NOTIFICATION_SEND_BATCH_SIZE=50

# ------------------------------------------------------------------------------
# OPTIONAL
# ------------------------------------------------------------------------------

# Where the application writes its log file. Defaults to `logs/` beside
# manage.py. Must be writable by the account running the application. Point it
# at a central location if DMRC has one.
# LOG_DIR=/var/log/dmrc-portal

# Cookies are marked HTTPS-only in production. Set this to False ONLY if TLS
# terminates elsewhere and the portal itself is reached over plain HTTP --
# otherwise sessions will not work.
# SECURE_COOKIES=True